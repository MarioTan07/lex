# Settings for running the site. On Vercel, set these under Project → Settings → Environment Variables.
# Connecting Turso and Blob from Vercel's Storage tab fills in their values automatically.

# Turso database (online). Leave empty on your own computer to use data/semanggi.db instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob, for product photos. Leave empty on your own computer to keep photos in data/uploads.
BLOB_READ_WRITE_TOKEN=

# The two admin accounts. They're created on first start if they don't exist yet.
# On Vercel both passwords must be set (unless you copy your local admins over with `npm run copy-to-turso`).
# On your own computer an empty password is generated and written to data/initial-admin.txt.
ADMIN_EMAIL=admin1@kampoengsemanggi.local
ADMIN_PASSWORD=
ADMIN2_EMAIL=admin2@kampoengsemanggi.local
ADMIN2_PASSWORD=

# Local only: port and data folder.
PORT=3000
DATA_DIR=./data
