# Copy these into your host's environment settings (or export them before `npm start`).
PORT=3000
# Folder for the SQLite database and uploaded photos. Put it on a persistent disk when you deploy.
DATA_DIR=./data
# The two admin accounts, created the first time the server starts. If a password is empty,
# a random one is generated and written to DATA_DIR/initial-admin.txt.
ADMIN_EMAIL=admin1@kampoengsemanggi.local
ADMIN_PASSWORD=
ADMIN2_EMAIL=admin2@kampoengsemanggi.local
ADMIN2_PASSWORD=
# Set to production when served over HTTPS so the sign-in cookie is marked Secure.
NODE_ENV=development
